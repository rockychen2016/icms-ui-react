{
  "name": "icms-components",
  "version": "0.1.6",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/styles.css"
  ],
  "sideEffects": [
    "dist/styles.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./style": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.tsx --dts --format cjs,esm --sourcemap --out-dir dist",
    "dev": "tsup --watch src/index.tsx --dts --format cjs,esm --out-dir dist",
    "build:css": "tailwindcss -i src/styles/globals.css -o dist/styles.css --minify",
    "postbuild": "npm run build:css",
    "prepare": "npm run build",
    "playground:dev": "cd playground && npm install && npm run dev",
    "playground:build": "cd playground && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "latest",
    "clsx": "^2.1.1",
    "postcss": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  }
}